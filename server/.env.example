NODE_ENV=development
PORT=3000
DATABASE_URL=

# Signs/verifies login JWTs. Generate a long random value:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters; under NODE_ENV=production a short or missing
# secret stops the server from starting.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call this API.
# Leave empty in development to allow any origin. REQUIRED in production —
# the server refuses to start without it.
# CORS_ORIGINS=https://hotels.thinkhealth.com,http://localhost:8080
CORS_ORIGINS=

# How many proxy hops in front of this server to trust for the client IP.
# 0 = directly exposed (default). Set to 1 behind a single reverse proxy or
# load balancer, otherwise rate limiting buckets every user under the proxy IP.
TRUST_PROXY=0

# --- Rate limiting (defaults shown; all optional) ---
# Failed logins allowed per IP per window. Successful logins don't count.
LOGIN_RATE_MAX_PER_IP=10
LOGIN_RATE_WINDOW_MS=900000
# Failed logins allowed per email address per window, across all IPs.
LOGIN_RATE_MAX_PER_ACCOUNT=20
LOGIN_RATE_ACCOUNT_WINDOW_MS=3600000
# Backstop limit across the whole /api surface, per IP.
API_RATE_MAX=600
API_RATE_WINDOW_MS=900000

# Path to pg_dump for npm run db:backup (only needed if pg_dump isn't on PATH)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe

# --- SMTP (required for the forgot-password OTP email) ---
# Without these set, reset codes are logged to the server console instead of
# emailed — fine for local dev, refused at startup under NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thinkhealth Hotel Database <no-reply@thinkhealth.com>
