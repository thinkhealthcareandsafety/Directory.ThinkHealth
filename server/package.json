{
  "name": "thinkhealth-hotel-hub-server",
  "version": "1.0.0",
  "description": "PostgreSQL + Express API for the Thinkhealth Hotel Database Hub",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "db:extract": "node scripts/extract-initial-hotels.js",
    "db:import": "node scripts/import-hotels.js",
    "db:import-csv": "node scripts/import-from-csv.js",
    "user:create": "node scripts/create-user.js",
    "test": "node --test tests/*.test.js",
    "user:passwd": "node scripts/set-password.js",
    "security:check": "node scripts/security-check.js",
    "db:backup": "node scripts/backup.js",
    "user:name": "node scripts/set-name.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.6.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
